-- Concat()
SELECT Product_Category,Product_Sub_Category, concat(Product_Category,"_",Product_Sub_Category) AS Product_Name
FROM Prod_dimen;


-- concate state and city name
SELECT State, City ,concat(State,"_",City) AS Location
FROM cust_dimen;


-- 2. UPPER()
SELECT upper(Customer_Name)
FROM cust_dimen;


-- 3. LOWER()
SELECT lower(Customer_Name)
 FROM cust_dimen;


-- 4. LENGTH()
SELECT Customer_Name, length(Customer_Name)
FROM cust_dimen;

-- 5. SUBSTRING(),LOCATE()
SELECT substring(Customer_Name, 1, locate(' ',Customer_Name)-1) AS first_Name
FROM cust_dimen;

-- Last name
SELECT Customer_Name, substring(Customer_Name,  locate( ' ' ,Customer_Name)+1) AS Last_Name
FROM cust_dimen;



-- Date-Time functions
-- Example 1: In which month were the most orders shipped? Here, we will count the number of shipments per month and then identify the month with the maximum shipments.
 SELECT count(Order_ID) AS Ship_count, MONTH(Ship_Date) AS shipping_month
 FROM shipping_dimen
 GROUP BY shipping_month
 ORDER BY Ship_count DESC
 LIMIT 1;


-- Example 2: Which month and year combination saw the most number of critical orders?
SELECT count(Ord_id) AS order_count , MONTH(Order_Date) AS order_month, year(Order_Date) AS order_year
 FROM orders_dimen
 WHERE Order_Priority= 'Critical'
 GROUP BY order_month, order_year
 ORDER BY order_count DESC
 LIMIT 1;



-- NOW Function
 -- returns the current date and time
SELECT Ord_id, NOW() AS current_datetime 
FROM orders_dimen;




-- Example: Suppose names of all the customers are in UPPER case and you want to convert them in title case
SELECT Customer_Name, CONCAT(
    (SUBSTRING(Customer_Name, 1, 1)), 
    LOWER(SUBSTRING(Customer_Name, 2, locate(' ',Customer_Name)-1)), 
    ' ',
    (SUBSTRING(Customer_Name, locate(' ' ,Customer_Name)+1,1)),
    LOWER(SUBSTRING(Customer_Name,locate (' ',Customer_Name) +2 ))
) AS title_case_name
FROM cust_dimen;


-- Regular Expressions
-- Example: Suppose you want to find names of all the customers who have a string ‘car’ in their name.
SELECT Customer_Name
FROM cust_dimen
WHERE Customer_Name regexp 'car';



-- Example: Find the names of all the customers beginning with a,b,c or d and ending with ‘er’.
SELECT Customer_Name
FROM cust_dimen
WHERE Customer_Name regexp '^[abcd].*er$';
