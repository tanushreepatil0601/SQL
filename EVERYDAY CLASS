-- Write a query to categorize discounts as 'High' (>=0.07), 'Medium' (0.05-0.07), and 'Low' (<0.05).

SELECT ord_id, discount,
CASE
	WHEN discount >= 0.07 THEN 'High'
    WHEN discount >= 0.05 AND discount < 0.07 THEN 'Medium'
    ELSE 'Low'
END as discount_category
FROM market_fact_full;
