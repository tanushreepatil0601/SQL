-- Rank Functions - I
-- Rank orders based on their total sales amount.
SELECT Ord_ID, Sales,
RANK() OVER (ORDER BY Sales DESC) AS Sales_rank
FROM market_fact_full;
select * froM MARKET_FACT_FULL;


-- Rank Orders by Profit within Each Customer Segment
-- Here, we aim to see how each order ranks in terms of profit within each customer segment: 
SELECT 
	Customer_Segment,
	Profit,
    RANK() OVER (PARTITION BY  Customer_Segment ORDER BY Profit DESC) AS Customer_rank
    FROM market_fact_full
    JOIN cust_dimen
    USING(Cust_id);


-- If we want to rank the products based on the order quantity, irrespective of the specific orders:
SELECT
	Ord_id,
	Order_Quantity,
    Product_Sub_Category,
    RANK() OVER (PARTITION BY Product_Sub_Category ORDER BY Order_Quantity DESC) product_rank
	FROM prod_dimen
    JOIN market_fact_full
    USING(Prod_id);


-- Suppose we want to find out how each order ranks by shipping cost within each shipping mode:
