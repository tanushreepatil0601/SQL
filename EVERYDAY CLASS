-- Concat()
SELECT Product_Category,Product_Sub_Category, concat(Product_Category,"_",Product_Sub_Category) AS Product_Name
FROM Prod_dimen;


-- concate state and city name
SELECT State, City ,concat(State,"_",City) AS Location
FROM cust_dimen;


-- 2. UPPER()
SELECT upper(Customer_Name)
FROM cust_dimen;


-- 3. LOWER()
SELECT lower(Customer_Name)
 FROM cust_dimen;


-- 4. LENGTH()
SELECT Customer_Name, length(Customer_Name)
FROM cust_dimen;

-- 5. SUBSTRING(),LOCATE()
SELECT substring(Customer_Name, 1, locate(' ',Customer_Name)-1) AS first_Name
FROM cust_dimen;

-- Last name
SELECT Customer_Name, substring(Customer_Name,  locate( ' ' ,Customer_Name)+1) AS Last_Name
FROM cust_dimen;



-- Date-Time functions
-- Example 1: In which month were the most orders shipped? Here, we will count the number of shipments per month and then identify the month with the maximum shipments.
 SELECT count(Order_ID) AS Ship_count, MONTH(Ship_Date) AS shipping_month
 FROM shipping_dimen
 GROUP BY shipping_month
 ORDER BY Ship_count DESC
 LIMIT 1;


-- Example 2: Which month and year combination saw the most number of critical orders?
SELECT count(Ord_id) AS order_count , MONTH(Order_Date) AS order_month, year(Order_Date) AS order_year
 FROM orders_dimen
 WHERE Order_Priority= 'Critical'
 GROUP BY order_month, order_year
 ORDER BY order_count DESC
 LIMIT 1;



-- NOW Function
 -- returns the current date and time
SELECT Ord_id, NOW() AS current_datetime 
FROM orders_dimen;


-- Example: Suppose names of all the customers are in UPPER case and you want to convert them in title case
SELECT Customer_Name, CONCAT(
    (SUBSTRING(Customer_Name, 1, 1)), 
    LOWER(SUBSTRING(Customer_Name, 2, locate(' ',Customer_Name)-1)), 
    ' ',
    (SUBSTRING(Customer_Name, locate(' ' ,Customer_Name)+1,1)),
    LOWER(SUBSTRING(Customer_Name,locate (' ',Customer_Name) +2 ))
) AS title_case_name
FROM cust_dimen;


-- Regular Expressions
-- Example: Suppose you want to find names of all the customers who have a string ‘car’ in their name.
SELECT Customer_Name
FROM cust_dimen
WHERE Customer_Name regexp 'car';



-- Example: Find the names of all the customers beginning with a,b,c or d and ending with ‘er’.
SELECT Customer_Name
FROM cust_dimen
WHERE Customer_Name regexp '^[abcd].*er$';



-- REGEXP_REPLACE
-- Example: Suppose we want to remove all digits from the Customer_Name field in the cust_dimen table:
SELECT Regexp_replace(Customer_Name, '[0-9]','') AS Customer_Name_Cleaned
FROM cust_dimen;

SELECT Regexp_replace( Ord_id, '[a-zA-Z]','') AS Ord_id_Cleaned
FROM orders_dimen;


-- REGEXP_SUBSTR
-- Example:  Imagine you want to extract the first word from the Customer_Name field in the cust_dimen table. Assuming a word is any sequence of characters at the beginning of the string before a space:
SELECT regexp_substr(Customer_Name,'^[^ ]+') AS First_name
FROM cust_dimen;

-- middle name
SELECT regexp_substr(Customer_Name,'^[ %]+') AS middle_name
FROM cust_dimen;


-- last name
SELECT regexp_substr(Customer_Name,'[^ ]+$') AS last_name
FROM cust_dimen;


-- Nested Queries
-- Example 1: Find the total sales for each order and compare it with the average sales for all orders.
SELECT ord_id, sum(sales),
(SELECT avg(sales) FROM market_fact_full) AS Average_sales
FROM market_fact_full 
GROUP BY ord_id;

-- Example 2: Find details of customers who have made orders above $5000.

 SELECT *
 FROM cust_dimen
 WHERE Cust_id IN (SELECT Cust_id
FROM market_fact_full 
GROUP BY Cust_id
HAVING SUM(sales) > 5000);


-- Example 3: Get the average sales per customer, then select customers with average sales above a certain threshold.

SELECT*
FROM cust_dimen
WHERE Cust_id IN (SELECT cust_id
FROM market_fact_full
GROUP BY cust_id
HAVING AVG(Sales) > 2000);


-- CTEs(Common table expression )

-- 1. Find the 5 products which resulted in the least losses. Which product had the highest product base
-- margin among these?
SELECT Prod_id,Product_Base_Margin, Profit
FROM market_fact_full
WHERE Profit < 0
ORDER BY Profit DESC
LIMIT 5;


-- Query named as least_losses
WITH least_losses AS (
SELECT Prod_id,Product_Base_Margin, Profit
FROM market_fact_full
WHERE Profit < 0
ORDER BY Profit DESC
LIMIT 5
)
SELECT *
FROM least_losses
WHERE Product_Base_Margin =(SELECT max(Product_Base_Margin) FROM least_losses);


-- HOMEWORK 2. Find all low-priority orders made in the month of April. Out of them, how many were made in the first half of the month?
WITH Low_Priority_Orders AS (
SELECT Ord_id,Order_Date
FROM orders_dimen
WHERE Order_Priority = 'LOW'
AND MONTH(Order_Date) = 4
)
SELECT COUNT(*) AS Orders_First_Half_April
FROM Low_Priority_Orders
WHERE DAY(Order_Date) <= 15;
 

