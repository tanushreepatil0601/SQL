-- Rank Functions - II
--  Rank products within each category based on their total sales, ensuring that ties receive the same rank and there are no gaps in ranking numbers.
SELECT Prod_id,
Product_Category,
Sales,
DENSE_RANK() OVER (PARTITION BY Product_Category ORDER BY Sales) AS product_wise_sales_rank
FROM market_fact_full
JOIN prod_dimen
USING (Prod_id);


-- Calculate the dense rank of each order based on the order quantity
SELECT Ord_id,
Order_Quantity,
DENSE_RANK() OVER (PARTITION BY Ord_id ORDER BY Order_Quantity) AS order_rank
FROM market_fact_full;


-- Calculate the percentile rank of each order based on the order quantity.
SELECT Ord_id,
Order_Quantity,
DENSE_RANK() OVER (ORDER BY Order_Quantity) AS order_rank,
ROUND ((PERCENT_RANK() OVER ( ORDER BY Order_Quantity)),2)AS percent_order_rank
FROM market_fact_full;


 -- Rank Functions - III

